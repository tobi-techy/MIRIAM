# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://miriam:miriam_password@localhost:5432/miriam

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Concentrate AI (primary LLM gateway). Get a key at https://concentrate.ai
# When CONCENTRATE_API_KEY is set, the agent uses the Concentrate Responses
# API (routing + fallbacks + prompt caching); OpenAI is fallback otherwise.
CONCENTRATE_API_KEY=
CONCENTRATE_BASE_URL=https://api.concentrate.ai/v1
CONCENTRATE_MODEL=gpt-5.6-terra
CONCENTRATE_TEMPERATURE=0.7
CONCENTRATE_MAX_TOKENS=4096
CONCENTRATE_TIMEOUT=60.0
CONCENTRATE_MAX_RETRIES=3
CONCENTRATE_ROUTING_SORT=performance
CONCENTRATE_FALLBACK_MODELS=claude-sonnet-5,gemini-3.6-flash,auto
CONCENTRATE_ENABLE_CACHING=true

# Security — DEV-ONLY placeholders below (start with dev- and are rejected
# in production by config/settings.py). Generate real secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=dev-encryption-key-change-in-production-must-be-32-chars
JWT_SECRET=dev-jwt-secret-change-in-production-must-be-32-chars
JWT_AUDIENCE=miriam-api
JWT_ISSUER=rail-backend
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Go Backend
GRPC_ENDPOINT=localhost:50051
GO_BACKEND_URL=http://localhost:8080

# CORS — comma-separated allowlist; do NOT use * in production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Observability
LOG_LEVEL=INFO

# Supermemory (long-term semantic memory)
# Obtain your API key from console.supermemory.ai → API Keys → Create API Key
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_TIMEOUT=20.0
SUPERMEMORY_MAX_RETRIES=2

# Glider B2B API (money pipeline: reads + strategy validation only)
# Get a key from developers@glider.fi. Use https://staging-api.glider.fi/v2
# for integration tests. Miriam never enrolls or withdraws on her own —
# those flows are two-stage and user-signed.
GLIDER_API_BASE_URL=https://api.glider.fi/v2
GLIDER_API_KEY=
GLIDER_REQUEST_TIMEOUT=20.0
GLIDER_MAX_RETRIES=2
GLIDER_OPERATION_POLL_SECONDS=3.0
GLIDER_OPERATION_MAX_POLLS=40

# Money pipeline thresholds (see docs/MONEY-RULES.md)
MONEY_DEFAULT_COUNTRY=NG
MONEY_DEFAULT_CURRENCY=NGN
MONEY_DEBT_FIRE_APR_PCT=15.0
MONEY_DEBT_JUDGMENT_APR_PCT=8.0
MONEY_INVESTABLE_HORIZON_FLOOR_MONTHS=24
MONEY_DRAWDOWN_TOLERANCE_PCT=40.0

# Money layers (hands -> judgment -> voice, via orchestrator.py)
# Leave this false unless the service runs exactly ONE process. Money turns read
# the ledger from Redis; falling back to process memory during a Redis outage
# would give the same user two ledgers. With this false, an outage refuses the
# turn instead ("I could not complete that. Try again.").
MONEY_SINGLE_PROCESS=false

# The ceiling above which a money movement needs the user's confirmation. ZERO
# means nothing moves without a tap: every movement becomes a challenge the user
# settles with a confirm_id. Keep it at 0 until the rail's inflow webhook has been
# right in production, because it is the setting that lets Miriam act on her own.
# This is NOT a duplicate of Go's p2p limits: those stay as the rail backstop.
APPROVAL_REQUIRED_ABOVE=0
