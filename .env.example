# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://miriam:miriam_password@localhost:5432/miriam

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Security
ENCRYPTION_KEY=
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Go Backend
GRPC_ENDPOINT=localhost:50051
GO_BACKEND_URL=http://localhost:8080

# CORS
ALLOWED_ORIGINS=*

# Observability
LOG_LEVEL=INFO

# Supermemory (long-term semantic memory)
# Obtain your API key from console.supermemory.ai → API Keys → Create API Key
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_TIMEOUT=20.0
SUPERMEMORY_MAX_RETRIES=2