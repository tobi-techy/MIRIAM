  "inflow_endpoint": {
    "endpoint": "POST /api/v1/money/inflow",
    "request_keys": [
      "payment_id",
      "amount",
      "source_raw"
    ],
    "response_keys": [
      "payment_id",
      "response",
      "decision",
      "receipt",
      "trace_id"
    ],
    "failure_statuses": {
      "400": "payment_id or amount missing",
      "409": "insufficient_state: the ledger cannot answer for this user",
