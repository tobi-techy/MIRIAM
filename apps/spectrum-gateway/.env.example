# Spectrum gateway env (see src/index.ts). No secrets are committed.
# Photon project (https://app.photon.codes). Unset = terminal only.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Miriam brain
MIRIAM_URL=http://localhost:8000
MIRIAM_TOKEN=
MIRIAM_USER_ID=terminal-user
GATEWAY_CHANNEL=terminal

# Where card/chart images land for the terminal provider
GATEWAY_OUT_DIR=/tmp/spectrum-gateway

# Local macOS iMessage (no Photon project needed). Set to 1 to read
# ~/Library/Messages/chat.db and send via Messages.app. Requires Full Disk
# Access for the terminal running the gateway, plus the allowlist below: the
# gateway refuses to start local iMessage without it.
GATEWAY_IMESSAGE_LOCAL=0
# The ONE test line (comma-separated phones/emails). Anyone else is ignored.
IMESSAGE_ALLOW_FROM=

# Optional tappable confirm link rendered on the card (Layer A). Unset =
# the card carries the confirm code only, which is the honest terminal default.
SPECTRUM_AUTHORIZE_BASE=
